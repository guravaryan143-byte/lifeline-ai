APP_NAME=LifeLine AI
APP_ENV=development
DATABASE_URL=postgresql+psycopg://lifeline@127.0.0.1:5432/lifeline
DATABASE_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
TEST_DATABASE_URL=
# Used only by the optional Docker Compose PostgreSQL service:
POSTGRES_DB=lifeline
POSTGRES_USER=lifeline
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
JWT_SECRET=replace-with-a-long-random-secret-before-use
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5
